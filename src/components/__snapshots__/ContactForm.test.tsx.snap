exports[`ContactForm markup > keeps its markup 1`] = `"<form noValidate="" class="grid gap-9" aria-label="Demo iletişim formu"><p class="badge self-start">Demo form — mesaj gönderilmez.</p><label class="field" for="name"><span class="label muted">Ad Soyad</span><input id="name" aria-invalid="false" autoComplete="name" name="name"/></label><div class="grid gap-9 md:grid-cols-2"><label class="field" for="phone"><span class="label muted">Telefon</span><input id="phone" aria-invalid="false" type="tel" autoComplete="tel" name="phone"/></label><label class="field" for="email"><span class="label muted">E-posta</span><input id="email" aria-invalid="false" type="email" autoComplete="email" name="email"/></label></div><fieldset><legend class="label muted">Proje türü</legend><div class="mt-3 flex flex-wrap gap-2" role="group"><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">Mimari Proje</button><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">İç Mimarlık</button><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">3D &amp; Animasyon</button><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">Uygulama &amp; Anahtar Teslim</button><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">Diğer</button></div></fieldset><label class="field" for="location"><span class="label muted">Konum (isteğe bağlı)</span><input id="location" name="location"/></label><label class="field" for="message"><span class="label muted">Mesaj</span><textarea id="message" name="message" rows="4" aria-invalid="false"></textarea></label><div class="flex flex-col gap-4 md:flex-row md:items-center"><button type="submit" class="btn w-full md:w-auto"><span>Formu doğrula</span><span class="arr" aria-hidden="true">→</span></button></div></form>"`;
