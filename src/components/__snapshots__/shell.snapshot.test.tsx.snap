exports[`shell markup > Footer with the call to action 1`] = `"<footer class="sec-k on-dark mass-in-l"><div class="wrap"><div class="pb-[clamp(64px,8vw,128px)]"><div class="rise"><h2 class="d-xl max-w-[14ch] xl:max-w-none">Bir sonraki mekânı <span class="w8">birlikte</span> çizelim.</h2></div><div class="rise mt-12 flex flex-col gap-3 md:mt-16" style="--d:0.1s"><a href="tel:+905425933175" class="d-m big-link inline-flex min-h-[44px] items-center self-start">0542 593 31 75</a><a href="mailto:gulcan.mimarlik@gmail.com" class="d-m big-link inline-flex min-h-[44px] items-center self-start break-all">gulcan.mimarlik@gmail.com</a></div><div class="rise mt-10" style="--d:0.2s"><a class="btn btn-day w-full sm:w-auto" href="/iletisim"><span>Projenizi konuşalım</span><span class="arr" aria-hidden="true">→</span></a></div></div><div class="grid grid-cols-4 gap-x-4 gap-y-10 border-t border-golge pt-12 md:grid-cols-8 md:gap-x-5 xl:grid-cols-12 xl:gap-x-6"><div class="col-span-4 md:col-span-4 xl:col-span-4"><span role="img" aria-label="Gül CAN Mimarlık" class="logo" style="width:320px;max-width:100%"></span></div><div class="col-span-4 md:col-span-2 xl:col-span-3 xl:col-start-6"><p class="label muted">Adres</p><address class="mt-3 not-italic"><span class="block">Cumhuriyet Mahallesi</span><span class="block">Şehit Mustafa Sarı Sokak No:114</span></address></div><nav aria-label="Alt menü" class="col-span-4 md:col-span-2 xl:col-span-3 xl:col-start-10"><p class="label muted">Sayfalar</p><ul class="mt-3 flex flex-col"><li><a class="big-link inline-flex min-h-[44px] items-center" href="/projeler">Projeler</a></li><li><a class="big-link inline-flex min-h-[44px] items-center" href="/hizmetler">Hizmetler</a></li><li><a class="big-link inline-flex min-h-[44px] items-center" href="/studyo">Stüdyo</a></li><li><a class="big-link inline-flex min-h-[44px] items-center" href="/iletisim">İletişim</a></li></ul></nav></div><div class="mt-12 flex flex-col gap-2 border-t border-golge pt-6 text-[14px