exports[`services page > keeps the rendered markup 1`] = `"<section class="pt-[var(--hdr)]"><div class="wrap sec-b !pb-[clamp(64px,8vw,120px)] grid grid-cols-4 gap-x-4 md:grid-cols-8 md:gap-x-5 xl:grid-cols-12 xl:gap-x-6"><h1 class="d-xl col-span-4 md:col-span-8 xl:col-span-9">Projenin her aşaması, <span class="w8">tek masada.</span></h1><p class="lead col-span-4 mt-10 max-w-[36ch] md:col-span-5 md:col-start-1 xl:col-span-4 xl:col-start-3">Dört kategori, on hizmet. Çizimden anahtar teslime her aşamayı birlikte ya da ayrı ayrı yürütüyoruz.</p></div></section><section id="mimari-tasarim" class="sec-b bg-kagit " aria-labelledby="mimari-tasarim-h"><div class="wrap grid grid-cols-4 gap-x-4 gap-y-12 md:grid-cols-8 md:gap-x-5 xl:grid-cols-12 xl:gap-x-6"><div class="col-span-4 md:col-span-8 xl:col-span-7 "><p class="label muted">01 / 04</p><h2 id="mimari-tasarim-h" class="d-l mt-4">Mimari Tasarım</h2><p class="lead mt-6 max-w-[30ch]">Yapının kütlesini, planını ve cephesini çiziyoruz.</p><ul class="mt-12 list-none border-t border-current"><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">Mimari Proje</h3><p class="muted">Yapının planını, kesitini ve cephesini kuran ana tasarım çalışması.</p></li><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">Proje</h3><p class="muted">Tasarımın çizim ve teknik dokümana dönüştüğü aşama.</p></li><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">Paket Proje</h3><p class="muted">Mimari projeyle birlikte ilgili çizimlerin tek elden yürütülmesi. Kapsam projeye göre birlikte netleştirilir.</p></li></ul><a class="tlink mt-8" href="/projeler/avlulu-konut">İlgili konsept proje →</a></div><div class="col-span-4 md:col-span-5 xl:col-span-4 xl:col-start-9 xl:mt-24"><div data-from="left" class="wipe" data-in="1"><div class="relative aspect-[4/5] overflow-hidden bg-beton"><img alt="Avlulu konut konsepti: giriş açıklığı ve avludaki zeytin ağacı" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; object-position: 52% 55%; color: transparent;" sizes="(min-width:1280px) 30vw, (min-width:768px) 60vw, 100vw" srcset="/_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fimages%2Fp1-cover.png&amp;w=3840&amp;q=75"></div></div><p class="caption mt-3">İllüstratif görsel · Konsept Çalışma</p></div></div></section><section id="ic-mimarlik" class="sec-k on-dark mass-in-l" aria-labelledby="ic-mimarlik-h"><div class="wrap grid grid-cols-4 gap-x-4 gap-y-12 md:grid-cols-8 md:gap-x-5 xl:grid-cols-12 xl:gap-x-6"><div class="col-span-4 md:col-span-8 xl:col-span-7 xl:col-start-6 xl:order-2"><p class="label muted">02 / 04</p><h2 id="ic-mimarlik-h" class="d-l mt-4">İç Mimarlık</h2><p class="lead mt-6 max-w-[30ch]">Mekânı kullanım, ışık ve malzeme üzerinden yeniden kuruyoruz.</p><ul class="mt-12 list-none border-t border-current"><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">İç Mimarlık Hizmetleri</h3><p class="text-siva">Mekânın yerleşim, malzeme ve ışık kurgusu.</p></li><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">Tasarım</h3><p class="text-siva">Mekâna özgü, fikirden detaya uzanan tasarım çalışması.</p></li></ul><a class="tlink mt-8" href="/projeler/daire-yenileme">İlgili konsept proje →</a></div><div class="col-span-4 md:col-span-5 xl:col-span-4 xl:col-start-2 xl:order-1 xl:mt-40"><div data-from="right" class="wipe" data-in="1"><div class="relative aspect-[4/5] overflow-hidden bg-beton"><img alt="Daire yenileme konsepti: salon" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; object-position: 50% 55%; color: transparent;" sizes="(min-width:1280px) 30vw, (min-width:768px) 60vw, 100vw" srcset="/_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fimages%2Fp2-cover.png&amp;w=3840&amp;q=75"></div></div><p class="caption mt-3">İllüstratif görsel · Konsept Çalışma</p></div></div></section><section id="gorsellestirme" class="sec-b bg-kagit mass-out-r" aria-labelledby="gorsellestirme-h"><div class="wrap grid grid-cols-4 gap-x-4 gap-y-12 md:grid-cols-8 md:gap-x-5 xl:grid-cols-12 xl:gap-x-6"><div class="col-span-4 md:col-span-8 xl:col-span-7 "><p class="label muted">03 / 04</p><h2 id="gorsellestirme-h" class="d-l mt-4">Görselleştirme</h2><p class="lead mt-6 max-w-[30ch]">Projeyi inşa edilmeden önce modelleyip gösteriyoruz.</p><ul class="mt-12 list-none border-t border-current"><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">3D Modelleme</h3><p class="muted">Projeyi yapılmadan önce üç boyutlu görmenizi sağlayan model.</p></li><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">Animasyon</h3><p class="muted">Modelin hareketli bir anlatıma dönüştüğü proje animasyonu.</p></li></ul><a class="tlink mt-8" href="/projeler/yamac-evi">İlgili konsept proje →</a></div><div class="col-span-4 md:col-span-5 xl:col-span-4 xl:col-start-9 xl:mt-40"><div data-from="left" class="wipe" data-in="1"><div class="relative aspect-[4/5] overflow-hidden bg-beton"><img alt="Yamaç evi konsepti: kademeli teraslar ve konsol hacim" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; object-position: 50% 50%; color: transparent;" sizes="(min-width:1280px) 30vw, (min-width:768px) 60vw, 100vw" srcset="/_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fimages%2Fp3-cover.png&amp;w=3840&amp;q=75"></div></div><p class="caption mt-3">İllüstratif görsel · Konsept Çalışma</p></div></div></section><section id="uygulama" class="sec-b bg-siva " aria-labelledby="uygulama-h"><div class="wrap grid grid-cols-4 gap-x-4 gap-y-12 md:grid-cols-8 md:gap-x-5 xl:grid-cols-12 xl:gap-x-6"><div class="col-span-4 md:col-span-8 xl:col-span-7 xl:col-start-6 xl:order-2"><p class="label muted">04 / 04</p><h2 id="uygulama-h" class="d-l mt-4">Uygulama</h2><p class="lead mt-6 max-w-[30ch]">Çizimi şantiyede takip ediyor, teslime kadar yürütüyoruz.</p><ul class="mt-12 list-none border-t border-current"><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">Uygulama</h3><p class="muted">Çizilen projenin yapıma dönüşmesi.</p></li><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">Şantiye Şefliği</h3><p class="muted">Şantiyede işin çizime uygun ilerlemesinin takibi. Kapsam birlikte netleştirilir.</p></li><li class="grid gap-1 border-b border-current/30 py-5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8"><h3 class="d-s">Anahtar Teslim</h3><p class="muted">Çizimden teslime sürecin tek elden yürütülmesi.</p></li></ul><a class="tlink mt-8" href="/projeler/daire-yenileme">İlgili konsept proje →</a></div><div class="col-span-4 md:col-span-5 xl:col-span-4 xl:col-start-2 xl:order-1 xl:mt-40"><div data-from="right" class="wipe" data-in="1"><div class="relative aspect-[4/5] overflow-hidden bg-beton"><img alt="Yenileme sonrası konsept salon" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; object-position: 50% 55%; color: transparent;" sizes="(min-width:1280px) 30vw, (min-width:768px) 60vw, 100vw" srcset="/_next/image?url=%2Fimages%2Fp2-after.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fp2-after.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fp2-after.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fp2-after.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fp2-after.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fp2-after.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fp2-after.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fp2-after.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fp2-after.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fp2-after.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fimages%2Fp2-after.png&amp;w=3840&amp;q=75"></div></div><p class="caption mt-3">İllüstratif görsel · Konsept Çalışma</p></div></div></section><section class="sec-b" aria-labelledby="sur-h"><div class="wrap"><h2 id="sur-h" class="d-l">Fikirden <span class="w3">yapıya.</span></h2><p class="lead mt-6 max-w-[34ch]">Altı adım. İsterseniz hepsini, isterseniz yalnızca ihtiyacınız olanı birlikte yürütürüz.</p><div class="proc mt-16 md:mt-24" data-in="1"><div class="proc-step" style="--i: 0;"><div class="proc-bar"></div><p class="label">01</p><p class="d-s mt-2 max-w-[16ch]">Tanışma ve ihtiyaç analizi</p></div><div class="proc-step" style="--i: 1;"><div class="proc-bar"></div><p class="label">02</p><p class="d-s mt-2 max-w-[16ch]">Konsept tasarım</p></div><div class="proc-step" style="--i: 2;"><div class="proc-bar"></div><p class="label">03</p><p class="d-s mt-2 max-w-[16ch]">3D modelleme ve görselleştirme</p></div><div class="proc-step" style="--i: 3;"><div class="proc-bar"></div><p class="label">04</p><p class="d-s mt-2 max-w-[16ch]">Mimari proje ve paket proje</p></div><div class="proc-step" style="--i: 4;"><div class="proc-bar"></div><p class="label">05</p><p class="d-s mt-2 max-w-[16ch]">Uygulama ve şantiye şefliği</p></div><div class="proc-step" style="--i: 5;"><div class="proc-bar"></div><p class="label">06</p><p class="d-s mt-2 max-w-[16ch]">Anahtar teslim</p></div></div><p class="caption mt-14 max-w-[52ch]">Paket Proje ve Şantiye Şefliği kapsamı projeye göre birlikte netleştirilir. Bu sayfa bir tasarım demosudur.</p></div></section>"`;
