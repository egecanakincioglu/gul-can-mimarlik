exports[`Contact page > keeps its markup 1`] = `"<section class="grid min-h-[100svh] pt-[var(--hdr)] xl:grid-cols-12"><div class="on-dark dark-bg px-[var(--pad)] py-14 md:py-20 xl:col-span-5 xl:flex xl:flex-col xl:justify-between xl:py-24"><div><h1 class="d-l max-w-[12ch]">Bir sonraki mekânı <span class="w3">birlikte</span> çizelim.</h1><div class="mt-10 grid gap-3 sm:grid-cols-2 xl:hidden"><a href="tel:+905425933175" class="btn btn-day"><span>Ara</span><span class="arr" aria-hidden="true">→</span></a><a href="mailto:gulcan.mimarlik@gmail.com" class="btn btn-ghost"><span>E-posta gönder</span><span class="arr" aria-hidden="true">→</span></a></div></div><div class="mt-14 grid gap-8 xl:mt-0"><div><p class="label muted">Telefon</p><a href="tel:+905425933175" class="d-m big-link mt-2 inline-flex min-h-[44px] items-center">0542 593 31 75</a></div><div><p class="label muted">E-posta</p><a href="mailto:gulcan.mimarlik@gmail.com" class="d-m big-link mt-2 inline-flex min-h-[44px] items-center break-all">gulcan.mimarlik@gmail.com</a></div><div><p class="label muted">Adres</p><address class="mt-2 not-italic"><span class="block">Cumhuriyet Mahallesi</span><span class="block">Şehit Mustafa Sarı Sokak No:114</span></address></div><div class="hidden gap-3 sm:grid-cols-2 xl:grid"><a href="tel:+905425933175" class="btn btn-day"><span>Ara</span><span class="arr" aria-hidden="true">→</span></a><a href="mailto:gulcan.mimarlik@gmail.com" class="btn btn-ghost"><span>E-posta gönder</span><span class="arr" aria-hidden="true">→</span></a></div></div></div><div class="bg-kirec px-[var(--pad)] py-14 md:py-20 xl:col-span-7 xl:py-24 xl:pl-[clamp(48px,6vw,112px)]"><h2 class="d-m">Projenizi kısaca anlatın.</h2><p class="muted mt-3 max-w-[44ch]">Bu form bir arayüz demosudur: alanlar doğrulanır, ancak mesaj hiçbir yere gönderilmez. Gerçek iletişim için telefon veya e-postayı kullanın.</p><div class="mt-10 max-w-[720px]"><form noValidate="" class="grid gap-9" aria-label="Demo iletişim formu"><p class="badge self-start">Demo form — mesaj gönderilmez.</p><label class="field" for="name"><span class="label muted">Ad Soyad</span><input id="name" aria-invalid="false" autoComplete="name" name="name"/></label><div class="grid gap-9 md:grid-cols-2"><label class="field" for="phone"><span class="label muted">Telefon</span><input id="phone" aria-invalid="false" type="tel" autoComplete="tel" name="phone"/></label><label class="field" for="email"><span class="label muted">E-posta</span><input id="email" aria-invalid="false" type="email" autoComplete="email" name="email"/></label></div><fieldset><legend class="label muted">Proje türü</legend><div class="mt-3 flex flex-wrap gap-2" role="group"><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">Mimari Proje</button><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">İç Mimarlık</button><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">3D &amp; Animasyon</button><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">Uygulama &amp; Anahtar Teslim</button><button type="button" aria-pressed="false" class="min-h-[44px] border border-pose px-4 text-[15px] font-medium aria-pressed:bg-pose aria-pressed:text-kirec">Diğer</button></div></fieldset><label class="field" for="location"><span class="label muted">Konum (isteğe bağlı)</span><input id="location" name="location"/></label><label class="field" for="message"><span class="label muted">Mesaj</span><textarea id="message" name="message" rows="4" aria-invalid="false"></textarea></label><div class="flex flex-col gap-4 md:flex-row md:items-center"><button type="submit" class="btn w-full md:w-auto"><span>Formu doğrula</span><span class="arr" aria-hidden="true">→</span></button></div></form></div></div></section><footer class="sec-k on-dark mass-in-r" style="padding-top:clamp(64px,7vw,112px)"><div class="wrap"><div class="grid grid-cols-4 gap-x-4 gap-y-10 border-t border-golge pt-12 md:grid-cols-8 md:gap-x-5 xl:grid-cols-12 xl:gap-x-6"><div class="col-span-4 md:col-span-4 xl:col-span-4"><span role="img" aria-label="Gül CAN Mimarlık" class="logo" style="width:320px;max-width:100%"></span></div><div class="col-span-4 md:col-span-2 xl:col-span-3 xl:col-start-6"><p class="label muted">Adres</p><address class="mt-3 not-italic"><span class="block">Cumhuriyet Mahallesi</span><span class="block">Şehit Mustafa Sarı Sokak No:114</span></address></div><nav aria-label="Alt menü" class="col-span-4 md:col-span-2 xl:col-span-3 xl:col-start-10"><p class="label muted">Sayfalar</p><ul class="mt-3 flex flex-col"><li><a class="big-link inline-flex min-h-[44px] items-center" href="/projeler">Projeler</a></li><li><a class="big-link inline-flex min-h-[44px] items-center" href="/hizmetler">Hizmetler</a></li><li><a class="big-link inline-flex min-h-[44px] items-center" href="/studyo">Stüdyo</a></li><li><a class="big-link inline-flex min-h-[44px] items-center" href="/iletisim">İletişim</a></li></ul></nav></div><div class="mt-12 flex flex-col gap-2 border-t border-golge pt-6 text-[14px] text-siva md:flex-row md:justify-between"><p>© 2026 Gül CAN Mimarlık</p><p>Bu site bir tasarım demosudur. Portföy içerikleri illüstratiftir.</p></div></div></footer>"`;
